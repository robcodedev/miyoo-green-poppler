+/* Miyoo Mini/Plus framebuffer is physically rotated 180 degrees.
+ * Correct output pixel coordinates, not Poppler/PDF rotation state.
+ * This is a compile-time Miyoo target feature, not a runtime option. */
+#ifdef GREEN_MIYOO_MINI
+#define GREEN_FB_ROTATED_180 1
+#else
+#define GREEN_FB_ROTATED_180 0
+#endif
+
+static inline Uint8 *Green_FramePixel(SDL_Surface *display, int x, int y, int inverted)
+{
+	if (inverted)
+	{
+		x = display->w - 1 - x;
+		y = display->h - 1 - y;
+	}
+	return (Uint8 *)display->pixels + y * display->pitch +
+		x * display->format->BytesPerPixel;
+}
