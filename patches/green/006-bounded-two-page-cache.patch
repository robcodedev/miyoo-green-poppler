+/* Two-page LRU cache, with a strict 6 MiB limit on retained Cairo buffers.
+ * The current page always remains cached, even if it exceeds the budget. */
+#define GREEN_CACHE_LIMIT (6u * 1024u * 1024u)
+
+static size_t Green_SurfaceBytes( cairo_surface_t *surface )
+{
+	if (!surface || cairo_surface_get_type( surface ) != CAIRO_SURFACE_TYPE_IMAGE)
+		return 0;
+	return (size_t)cairo_image_surface_get_stride( surface ) *
+		(size_t)cairo_image_surface_get_height( surface );
+}
