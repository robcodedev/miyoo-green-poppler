+	const int maxRecent = Green_CacheSetting("GREEN_CACHE_PAGES", 5, 2, 6) - 1;
+	const size_t budget = (size_t)Green_CacheSetting("GREEN_CACHE_MB", 12, 4, 24) * 1024u * 1024u;
+	size_t used = Green_SurfaceBytes(doc->cache.surface);
